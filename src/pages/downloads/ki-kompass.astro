---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  pageTitle="Der ultimative KI-Kompass – Gratis E-Book | 598 Seiten"
  description="Lade den ultimativen KI-Kompass gratis herunter – 598 Seiten extra verständlich für Anfänger aller Generationen. Vom 4x Buchautor und Verfasser des ersten großen deutschsprachigen KI-Lexikons."
>
  <section class="py-10 flex items-center justify-center bg-gradient-to-b from-brand-navy to-brand-navy/95">
    <div class="container max-w-3xl px-4 py-8 mx-auto">
      
      <div class="bg-white rounded-xl shadow-2xl p-6 md:p-8">
        
        <p class="text-xl md:text-2xl font-heading font-bold text-brand-red mb-1">
          Mein bestes Buch.
        </p>

        <h1 class="text-2xl md:text-3xl font-heading font-bold text-brand-navy mb-2">
          Der ultimative KI-Kompass
        </h1>
        <p class="text-sm md:text-base text-slate-600 mb-3">
          Extra verständlich für Anfänger aller Generationen
        </p>
        
        <div class="inline-block bg-brand-light px-3 py-1.5 rounded-lg mb-6">
          <p class="text-xs md:text-sm text-slate-700">
            598 Seiten | <span class="font-bold text-brand-red">1 Jahr Arbeit – Mein Geschenk an dich</span>
          </p>
        </div>


        <div class="brevo-form-wrapper">
          <iframe width="540" height="380" src="https://a57da0ee.sibforms.com/serve/MUIFAI6-ODovhBjF-czZulGHB5dHrAZaTmdi94uy6Lvp968_GYSZuh0hU8zpikwoTwFukiNBdP60Jeqaxs0hRrKZ_Kt0WPFWYui8x5gcUn8PqUnTqNYbzA3uefKpBN5BpSLQYJa_1rhi-TFWB54Ic8i4Zm_2bF7Xyyu0C9BpTEu7vvmxH0230boz3Li9Shxhll9YPqf531awDJiV0A==" frameborder="0" scrolling="auto" allowfullscreen style="display: block;margin-left: auto;margin-right: auto;max-width: 100%;"></iframe>
        </div>

        <p class="text-xs text-slate-500 text-center mt-4">
          Deine Daten sind sicher. Kein Spam. Jederzeit abmeldbar.
        </p>

        <div class="border-t border-slate-200 mt-6 pt-6 text-center">
          <h3 class="text-lg md:text-xl font-heading font-bold text-brand-navy mb-2">
            Du willst ein echtes Buch in der Hand halten?
          </h3>
          <p class="text-xs md:text-sm text-slate-600 mb-4">
            Optional kannst du es auch auf Amazon kaufen.
          </p>
          <a 
            href="https://amzn.eu/d/2xBuoOO" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-5 py-2.5 md:px-6 md:py-3 bg-brand-red text-white text-base font-bold rounded-lg hover:bg-brand-red/90 transition-colors"
          >
            Jetzt auf Amazon bestellen
          </a>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
.brevo-form-wrapper {
  min-height: 300px;
}
</style>