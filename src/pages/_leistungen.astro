            </svg>
          </button>
          
          <!-- Expandable Details -->
          <div id="training-details" class="hidden mt-6 pt-6 border-t border-slate-200">
            <div class="space-y-3">
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ AI Act-konforme Schulung</p>
                <p class="text-xs text-slate-700">Erfüllt die gesetzliche KI-Kompetenz-Pflicht</p>
              </div>
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ Prompting, das funktioniert</p>
                <p class="text-xs text-slate-700">Nicht Theorie, sondern Ergebnisse</p>
              </div>
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ Bias & Halluzinationen erkennen</p>
                <p class="text-xs text-slate-700">Fehler vermeiden, bevor sie passieren</p>
              </div>
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ DSGVO & Governance</p>
                <p class="text-xs text-slate-700">Rechtssichere Nutzung, klare Leitplanken</p>
              </div>
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ Zertifikat "KI-Führerschein"</p>
                <p class="text-xs text-slate-700">Nachweis für Audits, dokumentierbar</p>
              </div>
            </div>
            
            <!-- Danach-Satz -->
            <div class="mt-4 p-3 bg-brand-navy/5 rounded-lg border-l-4 border-brand-navy">
