        <!-- Box 3: Wochenend-Intensiv -->
        <div class="bg-white rounded-xl shadow-2xl p-6 hover:shadow-3xl transition-shadow cursor-pointer group">
          <div class="flex items-start gap-4 mb-4">
            <div class="text-4xl flex-shrink-0">⚡</div>
            <div class="flex-1">
              <span class="inline-block px-3 py-1 bg-brand-red text-white text-xs font-bold rounded-full mb-2">
                WOCHENENDE
              </span>
              <h2 class="text-xl md:text-2xl font-heading font-bold text-brand-navy mb-2">
                Wochenend-Intensiv
              </h2>
              <p class="text-sm text-brand-red font-semibold mb-3">
                Kleine Gruppen (max. 6) – Samstag oder Sonntag
              </p>
              <p class="text-sm text-slate-600 leading-relaxed">
                Fokus ohne Ablenkung: Ein Tag, intensive Praxis, fertige Workflows. Am Montag läuft's.
              </p>
            </div>
          </div>
          <button 
            onclick="toggleDetails('weekend')"
            class="mt-4 text-brand-navy font-bold text-sm hover:text-brand-red transition-colors flex items-center gap-2"
          >
            <span>Mehr erfahren</span>
            <svg class="w-4 h-4 transform transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
          
          <!-- Expandable Details -->
          <div id="weekend-details" class="hidden mt-6 pt-6 border-t border-slate-200">
            <div class="space-y-3">
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ Max. 6 Teilnehmer</p>
                <p class="text-xs text-slate-700">Persönlich, intensiv, keine Massenveranstaltung</p>
              </div>
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ Deine Use-Cases</p>
                <p class="text-xs text-slate-700">Du bringst mit, was du lösen willst</p>
              </div>
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ Sofort einsetzbar</p>
                <p class="text-xs text-slate-700">Montag startest du mit fertigen Workflows</p>
              </div>
              <div class="bg-brand-light p-3 rounded-lg">
                <p class="font-semibold text-brand-navy text-sm mb-1">✓ Samstag oder Sonntag</p>
                <p class="text-xs text-slate-700">Du wählst den Tag</p>
              </div>
            </div>
            
            <!-- Danach-Satz -->
            <div class="mt-4 p-3 bg-brand-navy/5 rounded-lg border-l-4 border-brand-navy">
              <p class="text-sm text-slate-700">
                <strong>Nach dem Workshop:</strong> Du hast fertige Workflows für deine echten Aufgaben, sparst ab Montag Zeit und weißt genau, wie du KI in deinem Alltag einsetzt.
              </p>
            </div>
            
            <div class="mt-4">
              <p class="text-xs font-semibold text-brand-navy mb-2">Format:</p>
              <p class="text-xs text-slate-600">1 Tag (6h) – 11:00 bis 17:00 Uhr – Online oder vor Ort</p>
              <p class="text-xs text-slate-600 mb-4">+ 2x jährlich 30 Min 1:1-Session</p>
            </div>
            
            <div class="mt-6">
              <p class="text-sm font-semibold text-brand-navy mb-2">Investition:</p>
              <p class="text-sm text-slate-600 mb-4">Auf Anfrage</p>
              <a href="https://tally.so/r/Y5PdoB" target="_blank" rel="noopener noreferrer" class="inline-block px-5 py-2 bg-brand-red text-white text-sm font-bold rounded-lg hover:bg-brand-redDark transition-colors">
