---
import BaseLayout from '../layouts/BaseLayout.astro';
import KiPresseEmbed from '../components/KiPresseEmbed.astro';

// Bauplan v2 (26.11.2026), Premium-Fassung. Siehe ENTWURF-STARTSEITE.md
const KURS_URL = 'https://www.caie.at/kurs';
const LINKEDIN = 'https://www.linkedin.com/in/david-mirga-847336134/';
const INSTAGRAM = 'https://www.instagram.com/davidmirga_ki_mit_ruhepuls/';
const AKTUALISIERT = '26. November 2026';

const faq = [
  {
    q: 'Ist das wirklich alles gratis?',
    a: 'Ja. Der Grundkurs, der KI-Kompass und das KI-Lexikon online kosten nichts. Du musst dich nirgends anmelden.',
  },
  {
    q: 'Brauche ich Vorwissen?',
    a: 'Nein. Wenn du eine E-Mail schreiben kannst, kannst du anfangen. Der Grundkurs beginnt ganz am Anfang.',
  },
  {
    q: 'Was hast du davon?',
    a: 'Ich will, dass mehr Menschen KI verstehen und selbst nutzen. Und bei jeder Frage, die mir jemand stellt, lerne ich selbst dazu.',
  },
  {
    q: 'Wer steckt hinter dem Grundkurs und den KI Presse News?',
    a: 'Beides habe ich geschrieben. Bereitgestellt werden sie vom Verein Center for AI and Ethics (CAIE) in Wien, in dem ich ehrenamtlich im Vorstand bin.',
  },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.davidmirga.com/#person",
      "name": "David Mirga",
      "jobTitle": "Diplomierter Strategischer KI-Manager und KI-Buchautor",
      "image": "https://www.davidmirga.com/images/david-mirga-hemd-hoch.jpg",
      "url": "https://www.davidmirga.com",
      "address": { "@type": "PostalAddress", "addressLocality": "Wien", "addressCountry": "AT" },
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "name": "Diplom Strategischer KI-Manager",
        "recognizedBy": { "@type": "Organization", "name": "BFI Wien" }
      },
      "memberOf": { "@type": "Organization", "name": "Center for AI and Ethics (CAIE)", "url": "https://www.caie.at" },
      "knowsAbout": ["Künstliche Intelligenz", "KI-Grundbildung", "KI im Arbeitsalltag", "KI im Betrieb einführen", "Generative KI", "Prompting"],
      "sameAs": [
        LINKEDIN,
        INSTAGRAM,
        "https://www.instagram.com/david_mirga_/",
        "https://x.com/davetherealrave",
        "https://kilexikon.com/"
      ],
      "description": "David Mirga aus Wien erklärt KI so, dass sie im Alltag funktioniert. Autor von drei KI-Büchern, darunter das erste große deutschsprachige KI-Lexikon mit über 5.000 Begriffen, und Autor eines kostenlosen KI-Grundkurses."
    },
    { "@type": "Book", "name": "Das große KI-Lexikon: 5000 Begriffe der Künstlichen Intelligenz", "isbn": "979-8286092918", "datePublished": "2025-06-04", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    { "@type": "Book", "name": "Der ultimative KI-Kompass", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    { "@type": "Book", "name": "KI endlich einfach erklärt", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    { "@type": "Book", "name": "Digitales Recruiting kinderleicht", "isbn": "978-3-7598-2368-7", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    }
  ]
});

const kennst = [
  { t: 'Alle reden von KI, und du fragst dich, ob dein Job bleibt.', link: KURS_URL, l: 'Im Grundkurs anfangen' },
  { t: 'Du sitzt vor ChatGPT und weißt nicht, was du eintippen sollst.', link: KURS_URL, l: 'Die erste Übung machen' },
  { t: 'Dein Team nutzt längst KI, und keiner redet darüber.', link: '/ki-check', l: 'Wo steht dein Betrieb?' },
  { t: 'Jeden Tag ein neues Wunder-Tool, und du weißt nicht, was davon stimmt.', link: '/ki-presse-news', l: 'Die Woche in Ruhe lesen' },
  { t: 'Du kennst die Tools, aber in deinem Team kommt KI nicht an.', link: '/blog', l: 'Gedanken dazu im Blog' },
];

const ext = (u: string) => u.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---

<BaseLayout
  pageTitle="Darf’s ein bisschen Hilfe sein? KI leicht verständlich"
  description="David Mirga aus Wien: KI leicht verständlich machen, zeigen, was möglich ist und was wirklich funktioniert, und wie auch alle im Team mitziehen können. Autor von drei KI-Büchern und des ersten großen deutschsprachigen KI-Lexikons mit über 5.000 Begriffen. KI-Grundkurs kostenlos, ohne Anmeldung."
>
  <script type="application/ld+json" slot="head-schema" set:html={schema} />

  <div class="bg-white text-brand-navy">

  <!-- 1 · KOPF -->
    <section class="pt-16 md:pt-24 pb-16 md:pb-20">
      <div class="container mx-auto px-6 md:px-10 max-w-6xl">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

          <div class="lg:col-span-7">
            <h1 class="font-sans font-semibold text-[2.5rem] leading-[1.05] md:text-[3.4rem] lg:text-[3.6rem] tracking-[-0.035em] text-[#132B2C] mb-7">
              Darf’s ein bisschen<br/>Hilfe sein?
            </h1>

            <p class="text-xl md:text-[1.35rem] leading-relaxed text-[#1F3B3A] mb-6 [text-wrap:pretty]">
              Im Rahmen des Vereins Center for AI and Ethics (caie.at) ist es meine Mission, KI den Menschen und Betrieben in Österreich näherzubringen und bei Herausforderungen, vor allem am Anfang, mit Tipps und Ratschlägen zu helfen.
            </p>

            <p class="text-lg md:text-xl leading-relaxed text-[#6B7A78] mb-10">
              KI leicht verständlich machen.<br/>
              Zeigen, was möglich ist und was wirklich funktioniert.<br/>
              Und wie auch alle im Team mitziehen können.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href={KURS_URL} target="_blank" rel="noopener" class="whitespace-nowrap inline-flex justify-center items-center gap-3 px-7 py-4 bg-brand-red text-white text-lg font-semibold rounded-xl hover:bg-brand-redDark transition-colors">
                Grundkurs kostenlos starten <span aria-hidden="true">→</span>
              </a>
              <a href="/downloads/ki-kompass" class="whitespace-nowrap inline-flex justify-center items-center px-7 py-4 text-[#132B2C] text-lg font-semibold rounded-xl ring-1 ring-[#132B2C]/15 hover:ring-[#132B2C]/40 transition">
                KI-Kompass lesen
              </a>
            </div>
            <p class="mt-3 text-base text-[#6B7A78]">Der Grundkurs ist beim Verein Center for AI and Ethics, Wien.</p>
          </div>

          <div class="lg:col-span-5">
            <figure class="max-w-sm mx-auto lg:max-w-none">
              <img
                src="/images/david-mirga-hemd-hoch.jpg"
                alt="David Mirga, KI-Buchautor aus Wien"
                width="640" height="800"
                class="w-full aspect-[4/5] object-cover rounded-2xl"
              />
              <figcaption class="mt-4 text-base text-[#6B7A78] leading-relaxed">
                <span class="font-semibold text-[#132B2C]">David Mirga</span>, Wien · Autor von drei KI-Büchern und des ersten großen deutschsprachigen KI-Lexikons
              </figcaption>
            </figure>
          </div>

        </div>

        <div class="mt-16 md:mt-20 pt-10 border-t border-[#132B2C]/10 text-center">
          <p class="text-base text-[#6B7A78] mb-3">Hier findest du Antworten auf die Frage</p>
          <p class="text-2xl md:text-[1.75rem] leading-snug font-medium tracking-[-0.01em] text-[#132B2C] max-w-3xl mx-auto [text-wrap:balance]">
            Wie komme ich bei KI mit, auch wenn ich kein Computer‑Genie bin, und wie nehme ich meine Mitarbeiter und Kollegen dabei mit?
          </p>
        </div>
      </div>
    </section>

  <!-- Zahlen -->
  <section class="border-y border-brand-navy/10 bg-white/60">
    <div class="container mx-auto px-6 md:px-10 max-w-6xl">
      <dl class="grid grid-cols-2 md:grid-cols-4 md:divide-x divide-brand-navy/10">
        <div class="py-8 px-4 text-center"><dt class="sr-only">Bücher</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">4</dd><p class="text-base text-brand-navy/65 mt-2">Fachbücher, drei über KI</p></div>
        <div class="py-8 px-4 text-center"><dt class="sr-only">Lexikon</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">5.000+</dd><p class="text-base text-brand-navy/65 mt-2">Begriffe im KI-Lexikon</p></div>
        <div class="py-8 px-4 text-center"><dt class="sr-only">Kurs</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">39</dd><p class="text-base text-brand-navy/65 mt-2">Lektionen im Grundkurs</p></div>
        <div class="py-8 px-4 text-center"><dt class="sr-only">Weiterbildungen</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">20+</dd><p class="text-base text-brand-navy/65 mt-2">KI-Weiterbildungen gemacht</p></div>
      </dl>
    </div>
  </section>

  <!-- 2 · KENNST DU DAS? -->
  <section class="bg-brand-navy text-[#F7F4EE] py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-10 max-w-5xl">
      <p class="flex items-center gap-3 text-sm font-semibold tracking-[0.2em] uppercase text-[#E3A07C] mb-6">
        <span class="w-10 h-px bg-[#E3A07C]"></span> Kennst du das?
      </p>
      <h2 class="font-serif text-4xl md:text-5xl leading-tight tracking-[-0.01em] mb-14 max-w-3xl">
        Die meisten Fragen zu KI beginnen nicht mit Technik, sondern mit einem Gefühl.
      </h2>
      <ol class="border-t border-white/15">
        {kennst.map((k, i) => (
          <li class="border-b border-white/15">
            <a href={k.link} {...ext(k.link)} class="group grid md:grid-cols-12 gap-3 md:gap-8 py-7 md:py-8 items-baseline">
              <span class="md:col-span-1 font-serif text-xl text-[#E3A07C]">0{i + 1}</span>
              <span class="md:col-span-7 text-xl md:text-2xl leading-snug text-[#F7F4EE]">{k.t}</span>
              <span class="md:col-span-4 md:text-right text-base font-semibold text-[#F7F4EE]/70 group-hover:text-[#E3A07C] transition-colors">{k.l} <span aria-hidden="true" class="inline-block group-hover:translate-x-1 transition-transform">→</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3 · SELBST LERNEN -->
  <section class="py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-10 max-w-6xl">
      <div class="max-w-3xl mb-16">
        <p class="flex items-center gap-3 text-sm font-semibold tracking-[0.2em] uppercase text-brand-red mb-6">
          <span class="w-10 h-px bg-brand-red"></span> Gratis · ohne Anmeldung
        </p>
        <h2 class="font-serif text-4xl md:text-5xl leading-tight tracking-[-0.01em]">Selbst lernen, im eigenen Tempo.</h2>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 pb-16 mb-16 border-b border-brand-navy/10">
        <div class="lg:col-span-5">
          <p class="text-sm font-semibold tracking-[0.2em] uppercase text-brand-navy/55 mb-3">KI-Grundkurs</p>
          <h3 class="font-serif text-3xl md:text-4xl leading-tight mb-6">KI sicher im Alltag nutzen</h3>
          <a href={KURS_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-3 px-8 py-4 bg-brand-red text-white text-lg font-semibold rounded-full hover:bg-brand-redDark transition-colors">
            Grundkurs starten <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="lg:col-span-7 text-xl leading-relaxed text-brand-navy/80 space-y-5">
          <p>39 kurze Lektionen, jede mit einem kleinen Wissens-Check. Du lernst an Aufgaben aus dem echten Leben.</p>
          <p class="border-l-2 border-brand-red pl-6 italic font-serif text-2xl text-brand-navy">Du gibst der KI einen schwierigen Brief und lässt dir erklären, was von dir verlangt wird. Dann prüfst du selbst, ob Betrag und Frist stimmen.</p>
          <p class="text-base text-brand-navy/60">Geschrieben von mir, bereitgestellt vom Verein Center for AI and Ethics (CAIE).</p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 md:gap-16">
        <a href="/downloads/ki-kompass" class="group flex gap-8 items-start">
          <img src="/ki-kompass.jpg" alt="Buchcover Der ultimative KI-Kompass" class="w-32 md:w-36 rounded shadow-[0_20px_40px_-15px_rgba(19,43,44,0.5)] group-hover:-translate-y-1 transition-transform flex-shrink-0" />
          <div>
            <h3 class="font-serif text-2xl md:text-3xl leading-tight mb-3">Der ultimative KI-Kompass</h3>
            <p class="text-lg text-brand-navy/70 mb-4">598 Seiten, verständlich für alle. Als Geschenk zum Herunterladen.</p>
            <span class="text-brand-red font-semibold text-lg">Gratis lesen →</span>
          </div>
        </a>
        <a href="https://kilexikon.com/" target="_blank" rel="noopener" class="group flex gap-8 items-start">
          <img src="/images/cover-lexikon.jpg" alt="Buchcover Das große KI-Lexikon" class="w-32 md:w-36 rounded shadow-[0_20px_40px_-15px_rgba(19,43,44,0.5)] group-hover:-translate-y-1 transition-transform flex-shrink-0" />
          <div>
            <h3 class="font-serif text-2xl md:text-3xl leading-tight mb-3">Das große KI-Lexikon</h3>
            <p class="text-lg text-brand-navy/70 mb-4">Das erste große deutschsprachige KI-Lexikon. Über 5.000 Begriffe, klar erklärt.</p>
            <span class="text-brand-red font-semibold text-lg">Begriff nachschlagen →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4 · ZUM VERTIEFEN -->
  <section class="py-24 md:py-32 bg-white/70 border-t border-brand-navy/10">
    <div class="container mx-auto px-6 md:px-10 max-w-6xl">
      <div class="max-w-3xl mb-16">
        <p class="flex items-center gap-3 text-sm font-semibold tracking-[0.2em] uppercase text-brand-red mb-6">
          <span class="w-10 h-px bg-brand-red"></span> Zum Vertiefen
        </p>
        <h2 class="font-serif text-4xl md:text-5xl leading-tight tracking-[-0.01em]">Für alle, die schon mit KI arbeiten.</h2>
      </div>

      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-5 max-w-md mx-auto lg:mx-0 w-full">
          <div class="relative shadow-[0_30px_60px_-25px_rgba(19,43,44,0.5)] rounded-sm overflow-hidden">
            <KiPresseEmbed variant="titel" title="KI Presse News – Titelseite der aktuellen Ausgabe" />
            <a href="/ki-presse-news" class="absolute inset-0 z-10" aria-label="KI Presse News lesen"></a>
          </div>
        </div>

        <div class="lg:col-span-7 divide-y divide-brand-navy/10 border-y border-brand-navy/10">
          <div class="py-8">
            <h3 class="font-serif text-2xl md:text-3xl mb-3">KI Presse News</h3>
            <p class="text-lg text-brand-navy/75 leading-relaxed mb-4">Jede Woche die wichtigsten KI-Nachrichten, kurz und mit Originalquellen. Herausgegeben vom Verein Center for AI and Ethics, in dem ich im Vorstand bin.</p>
            <a href="/ki-presse-news" class="text-brand-red font-semibold text-lg">Aktuelle Ausgabe lesen →</a>
          </div>
          <div class="py-8">
            <h3 class="font-serif text-2xl md:text-3xl mb-3">KI mit Ruhepuls</h3>
            <p class="text-lg text-brand-navy/75 leading-relaxed mb-4">Jeden Werktag ein kurzer KI-Impuls. Ohne Hype, ohne Fachchinesisch.</p>
            <a href={LINKEDIN} target="_blank" rel="noopener" class="text-brand-red font-semibold text-lg">LinkedIn →</a>
            <span class="text-brand-navy/30 mx-3">·</span>
            <a href={INSTAGRAM} target="_blank" rel="noopener" class="text-brand-red font-semibold text-lg">Instagram →</a>
          </div>
          <div class="py-8">
            <h3 class="font-serif text-2xl md:text-3xl mb-3">Blog</h3>
            <p class="text-lg text-brand-navy/75 leading-relaxed mb-4">Längere Texte zu KI im Alltag und im Betrieb.</p>
            <a href="/blog" class="text-brand-red font-semibold text-lg">Zum Blog →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · HÄUFIGE FRAGEN -->
  <section class="py-24 md:py-32 border-t border-brand-navy/10">
    <div class="container mx-auto px-6 md:px-10 max-w-4xl">
      <h2 class="font-serif text-4xl md:text-5xl leading-tight tracking-[-0.01em] mb-12">Häufige Fragen</h2>
      <div class="border-t border-brand-navy/15">
        {faq.map((f) => (
          <details class="group border-b border-brand-navy/15">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-6 py-7">
              <h3 class="text-xl md:text-2xl font-medium">{f.q}</h3>
              <span class="w-10 h-10 flex-shrink-0 rounded-full border border-brand-navy/25 flex items-center justify-center text-brand-red text-2xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-lg md:text-xl text-brand-navy/75 leading-relaxed pb-8 max-w-3xl">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 · KONTAKT -->
  <section id="kontakt" class="bg-brand-navy text-[#F7F4EE] py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-10 max-w-4xl text-center">
      <h2 class="font-serif text-5xl md:text-6xl leading-tight tracking-[-0.02em] mb-6">Steckst du fest?</h2>
      <p class="text-xl md:text-2xl text-[#F7F4EE]/80 mb-12">Schreib mir. Ich antworte persönlich.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:mail.davidmirga@gmail.com" class="inline-flex justify-center items-center px-9 py-4 bg-[#F7F4EE] text-brand-navy text-lg font-semibold rounded-full hover:bg-[#E3A07C] transition-colors">Schreib mir</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-9 py-4 border border-[#F7F4EE]/30 text-[#F7F4EE] text-lg font-semibold rounded-full hover:border-[#E3A07C] hover:text-[#E3A07C] transition-colors">Auf LinkedIn</a>
      </div>
      <p class="mt-14 text-[#F7F4EE]/65 text-lg">
        Lieber erst selbst probieren? <a href={KURS_URL} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-[#E3A07C] hover:text-[#E3A07C]">Grundkurs kostenlos starten</a>
      </p>
      <p class="mt-6 text-[#F7F4EE]/45 text-sm">Zuletzt aktualisiert: {AKTUALISIERT}</p>
    </div>
  </section>

  </div>
</BaseLayout>
