---
import BaseLayout from '../layouts/BaseLayout.astro';
import KiPresseEmbed from '../components/KiPresseEmbed.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "David Mirga",
  "jobTitle": "Diplomierter KI-Manager & Buchautor",
  "image": "https://www.davidmirga.com/images/david-mirga-profil.png",
  "url": "https://www.davidmirga.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Wien",
    "addressCountry": "AT"
  },
  "sameAs": [
    "https://www.linkedin.com/in/david-mirga-847336134/",
    "https://www.instagram.com/david_mirga_/",
    "https://x.com/davetherealrave",
    "https://kilexikon.com/"
  ],
  "description": "Diplomierter KI-Manager und Autor von vier Fachbüchern – darunter das erste große deutschsprachige KI-Lexikon. Aus Wien."
});
---

<BaseLayout
  pageTitle="Startseite"
  description="David Mirga – Diplomierter KI-Manager, Autor von 4 Fachbüchern und Verfasser des ersten großen deutschsprachigen KI-Lexikons. Aus Wien."
>
  <script type="application/ld+json" slot="head-schema" set:html={schema} />

  <!-- HERO -->
  <section class="pt-12 pb-10 bg-brand-navy relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-[120px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-red-500/5 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/4 pointer-events-none"></div>

    <div class="container mx-auto px-6 md:px-8 max-w-6xl relative z-10">
      <div class="flex flex-col lg:flex-row items-center lg:items-start gap-12 lg:gap-14">

        <!-- Text -->
        <div class="flex-1 text-center lg:text-left lg:pt-4">
          <div class="flex items-center justify-center lg:justify-start gap-4 mb-6">
            <img
              src="/images/David-Mirga.jpg"
              alt="David Mirga – KI-Manager und Buchautor aus Wien"
              class="w-16 h-16 md:w-20 md:h-20 rounded-full object-cover object-top shadow-xl ring-2 ring-white/20 flex-shrink-0"
            />
            <div class="text-left">
              <p class="text-brand-red font-semibold tracking-widest uppercase text-xs mb-1">
                David Mirga · Wien
              </p>
              <p class="text-white/75 text-sm tracking-wide">
                Diplom. KI-Manager · Verfasser des ersten großen deutschsprachigen KI-Lexikons
              </p>
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-black text-white leading-tight tracking-tight mb-6">
            KI verständlich.<br/>
            <span class="text-brand-red">Ohne Ausreden.</span>
          </h1>

          <p class="text-lg text-white/60 leading-relaxed max-w-xl mb-10">
            Ich schreibe Bücher und Artikel über KI. Ich lerne jeden Tag dazu. Und ich erkläre — so, dass KI nicht nur in Powerpoints existiert, sondern wirklich ankommt.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a
              href="mailto:mail.davidmirga@gmail.com"
              class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg shadow-lg hover:bg-red-700 transition-all text-center"
            >
              Schreib mir
            </a>
            <a
              href="/ueber-mich"
              class="px-8 py-4 bg-white/10 text-white border border-white/20 font-bold rounded-lg hover:bg-white/20 transition-colors text-center"
            >
              Meine Geschichte →
            </a>
          </div>
        </div>

        <!-- KI Presse News: aktuelle Titelseite von caie.at, wechselt jede Woche automatisch (Dave 25.11.2026) -->
        <aside class="w-full max-w-md lg:w-[420px] flex-shrink-0" aria-label="KI Presse News – aktuelle Ausgabe">
          <p class="flex items-center justify-between text-base mb-3">
            <span class="text-[#E9C7B1] font-semibold tracking-[0.12em] md:tracking-[0.18em] uppercase whitespace-nowrap">Mein Newsletter</span>
            <span class="flex items-center gap-2 text-white/70 whitespace-nowrap"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>aktuelle Ausgabe</span>
          </p>
          <div class="relative rotate-[1.2deg] hover:rotate-0 transition-transform duration-300">
            <div class="absolute inset-0 translate-x-2 translate-y-2 bg-[#C5A48E]/40 rounded-sm"></div>
            <div class="relative shadow-2xl shadow-black/40 ring-1 ring-black/10 rounded-sm overflow-hidden">
              <KiPresseEmbed variant="titel" title="KI Presse News – Titelseite der aktuellen Ausgabe" />
            </div>
            <a href="/ki-presse-news" class="absolute inset-0 z-10" aria-label="KI Presse News lesen"></a>
          </div>
          <a
            href="/ki-presse-news"
            class="mt-6 flex items-center justify-between w-full px-6 py-4 bg-white text-brand-navy font-bold rounded-lg shadow-lg hover:bg-[#F7F3EA] transition-colors"
          >
            Ausgabe lesen
            <span class="text-brand-red">→</span>
          </a>
          <p class="mt-3 text-white/60 text-base text-center">Jede Woche, mit Originalquellen. Erscheint beim Verein CAIE.</p>
        </aside>

      </div>
    </div>
  </section>

  <!-- CREDIBILITY BAR -->
  <section class="py-6 bg-brand-navy border-t border-white/5">
    <div class="container mx-auto px-6 md:px-8 max-w-4xl">
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14">
        <div class="text-center">
          <p class="text-white font-black text-lg tracking-tight leading-none">Dipl. KI-Manager</p>
          <p class="text-white/60 text-[10px] uppercase tracking-widest mt-1">KI seit 2022</p>
        </div>
        <div class="w-px h-6 bg-white/10 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-white font-black text-sm tracking-tight leading-none">Erstes KI-Lexikon</p>
          <p class="text-white/60 text-[10px] uppercase tracking-widest mt-1">auf Deutsch · 5.000+ Begriffe</p>
        </div>
        <div class="w-px h-6 bg-white/10 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-white font-black text-2xl tracking-tight leading-none">4</p>
          <p class="text-white/60 text-[10px] uppercase tracking-widest mt-1">Fachbücher</p>
        </div>
        <div class="w-px h-6 bg-white/10 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-white font-black text-2xl tracking-tight leading-none">20+</p>
          <p class="text-white/60 text-[10px] uppercase tracking-widest mt-1">KI-Zertifizierungen</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION / WOFÜR ICH STEHE -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 md:px-8 max-w-4xl">

      <div class="text-center mb-10">
        <p class="text-brand-red font-semibold tracking-widest uppercase text-xs mb-3">Meine Mission</p>
        <h2 class="text-3xl md:text-4xl font-heading font-black text-brand-navy tracking-tight mb-4">
          Die Angst vor KI nehmen.
        </h2>
        <p class="text-slate-700 max-w-xl mx-auto leading-relaxed">
          Seit 2022 arbeite ich daran, Menschen zu befähigen KI selbstständig zu nutzen — nicht abhängig von Beratern zu werden. Ich gebe praktische Tools und Workflows an die Hand, die wirklich funktionieren.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <div class="bg-brand-light rounded-2xl p-8 border border-slate-100">
          <h3 class="font-heading font-black text-brand-navy text-base mb-5 tracking-tight">Dafür stehe ich</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-brand-red font-black mt-0.5 flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-brand-navy text-sm">Befähigung statt Abhängigkeit</p>
                <p class="text-sm text-slate-600 mt-0.5">Du lernst es selbst — nicht für immer auf Berater angewiesen sein.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-red font-black mt-0.5 flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-brand-navy text-sm">Praxis statt Theorie</p>
                <p class="text-sm text-slate-600 mt-0.5">Was ich zeige, habe ich selbst getestet und im Einsatz.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-red font-black mt-0.5 flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-brand-navy text-sm">Funktioniert statt "müsste eigentlich"</p>
                <p class="text-sm text-slate-600 mt-0.5">Kein Konzept das in der Schublade landet.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-red font-black mt-0.5 flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-brand-navy text-sm">Verständlich statt Fach-Jargon</p>
                <p class="text-sm text-slate-600 mt-0.5">KI erklärt so, dass du es verstehst — und selbst machen kannst.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-slate-200">
          <h3 class="font-heading font-black text-brand-navy text-base mb-5 tracking-tight">Dagegen stehe ich</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-slate-400 font-black mt-0.5 flex-shrink-0">✗</span>
              <div>
                <p class="font-bold text-slate-600 text-sm line-through decoration-slate-400">Angstmacherei</p>
                <p class="text-sm text-slate-500 mt-0.5">"KI ersetzt euch!" — Nein. Sie macht euch besser.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-slate-400 font-black mt-0.5 flex-shrink-0">✗</span>
              <div>
                <p class="font-bold text-slate-600 text-sm line-through decoration-slate-400">Hilflosigkeit</p>
                <p class="text-sm text-slate-500 mt-0.5">"Ihr versteht das eh nicht" — Jeder kann das lernen.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-slate-400 font-black mt-0.5 flex-shrink-0">✗</span>
              <div>
                <p class="font-bold text-slate-600 text-sm line-through decoration-slate-400">Berater die reden statt umsetzen</p>
                <p class="text-sm text-slate-500 mt-0.5">25 Jahre Business-Praxis, nicht Elfenbeinturm.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-slate-400 font-black mt-0.5 flex-shrink-0">✗</span>
              <div>
                <p class="font-bold text-slate-600 text-sm line-through decoration-slate-400">200-Seiten-Konzepte</p>
                <p class="text-sm text-slate-500 mt-0.5">Die in der Schublade landen und nichts verändern.</p>
              </div>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- BUCH – KI-Kompass als Geschenk -->
  <section class="py-20 bg-brand-light">
    <div class="container mx-auto px-6 md:px-8 max-w-4xl">

      <!-- KI-Kompass HERO – Hauptbuch -->
      <div class="bg-brand-navy rounded-2xl overflow-hidden shadow-2xl mb-6 ring-1 ring-white/5">
        <div class="flex flex-col md:flex-row">

          <!-- Linke Seite: Buchinfo -->
          <div class="flex-1 p-8 md:p-12">
            <p class="text-xl md:text-2xl font-heading font-bold text-brand-red mb-1">
              Mein bestes Buch.
            </p>
            <h2 class="text-3xl md:text-4xl font-heading font-black text-white leading-tight tracking-tight mb-3">
              Der ultimative<br/>KI-Kompass
            </h2>
            <p class="text-white/60 text-sm font-medium mb-1 tracking-wide">
              598-Seiten E-Book — extra verständlich für alle
            </p>
            <p class="text-white/30 text-xs mb-8 tracking-wide">
              1 Jahr Arbeit · Auf Amazon erhältlich — Mein Geschenk an dich.
            </p>

            <!-- Stats -->
            <div class="flex gap-8 mb-8">
              <div>
                <p class="text-white font-black text-3xl tracking-tight">598</p>
                <p class="text-white/40 text-xs uppercase tracking-widest mt-0.5">Seiten</p>
              </div>
              <div class="w-px bg-white/10"></div>
              <div>
                <div class="flex items-center gap-1 mb-0.5">
                  <p class="text-white font-black text-3xl tracking-tight">5,0</p>
                  <svg class="w-5 h-5 text-amber-400 mb-0.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                </div>
                <p class="text-white/40 text-xs uppercase tracking-widest">Amazon</p>
              </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="/downloads/ki-kompass"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-brand-red text-white font-black rounded-xl hover:bg-red-700 transition-all duration-200 text-sm shadow-lg shadow-brand-red/20"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Als Geschenk herunterladen
              </a>
              <a
                href="https://amzn.eu/d/2xBuoOO"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white/8 text-white font-bold rounded-xl hover:bg-white/15 transition-all duration-200 border border-white/15 text-sm"
              >
                Auf Amazon ansehen
              </a>
            </div>
          </div>

          <!-- Rechte Seite: Buchcover -->
          <div class="flex items-center justify-center p-6 md:p-10 border-t border-white/5 md:border-t-0 md:border-l md:w-72 md:flex-shrink-0">
            <img
              src="/ki-kompass.jpg"
              alt="Der ultimative KI-Kompass – E-Book von David Mirga, 598 Seiten"
              class="w-44 md:w-60 rounded-lg shadow-2xl"
            />
          </div>

        </div>
      </div>

      <!-- KI-Lexikon — volle Zeile -->
      <a
        href="https://kilexikon.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:border-brand-red/30 transition-all duration-200 overflow-hidden flex flex-col sm:flex-row gap-0 mb-4"
      >
        <div class="flex-shrink-0 sm:w-20 flex items-center justify-center p-5 sm:py-6 bg-slate-50">
          <img
            src="/images/cover-lexikon.jpg"
            alt="Das große deutschsprachige KI-Lexikon"
            class="w-16 h-20 object-cover rounded-lg shadow-sm"
          />
        </div>
        <div class="flex flex-col justify-center px-6 py-5 flex-1">
          <span class="inline-block px-2 py-0.5 bg-green-50 text-green-700 text-xs font-bold rounded-full mb-2 w-fit">
            Bereits erhältlich
          </span>
          <h3 class="font-heading font-bold text-brand-navy text-base group-hover:text-brand-red transition-colors leading-snug mb-1">
            Das große deutschsprachige KI-Lexikon
          </h3>
          <p class="text-sm text-slate-500 mb-3">Das erste umfassende KI-Nachschlagewerk auf Deutsch — 5.000+ Begriffe, klar erklärt.</p>
          <span class="text-brand-red text-sm font-bold">kilexikon.com →</span>
        </div>
        <div class="hidden sm:flex flex-shrink-0 items-center pr-6">
          <svg class="w-5 h-5 text-slate-300 group-hover:text-brand-red transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </a>

      <!-- Compliance Notiz -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm flex gap-4 p-4 items-center">
        <div class="flex-shrink-0 w-14 h-14 bg-slate-50 rounded-lg border border-slate-100 flex items-center justify-center">
          <span class="text-2xl">🔒</span>
        </div>
        <div>
          <p class="text-xs text-slate-400 font-bold uppercase tracking-wide mb-0.5">In Arbeit</p>
          <h3 class="font-heading font-bold text-brand-navy text-sm leading-snug mb-0.5">
            KI, Datenschutz & Compliance
          </h3>
        </div>
      </div>
    </div>
  </section>

  <!-- BIO TEASER -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-6 md:px-8 max-w-4xl">
      <div class="bg-brand-light rounded-2xl p-8 md:p-12 flex flex-col md:flex-row gap-10 items-center border border-slate-100">

        <div class="md:w-56 flex-shrink-0 flex justify-center">
          <img
            src="/images/david-mirga-profil.png"
            alt="David Mirga - KI-Manager und Buchautor"
            width="220"
            height="220"
            class="rounded-2xl shadow-lg object-cover object-top w-44 h-44 md:w-56 md:h-56 ring-4 ring-white"
          />
        </div>

        <div class="flex-1 space-y-4">
          <h2 class="text-2xl md:text-3xl font-heading font-black text-brand-navy tracking-tight">
            Nicht der typische Tech-Nerd.
          </h2>
          <p class="text-slate-700 leading-relaxed">
            Ich komme nicht aus dem Silicon Valley. Ich habe Maurer gelernt, Unternehmen aufgebaut und bin über Umwege zum KI-Experten geworden —
            weil ich verstanden habe, dass Technologie nur dann etwas wert ist, wenn sie <strong>echte Probleme löst</strong>.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Diplomierter KI-Manager. Autor von vier Fachbüchern. Ich lerne, schreibe und teile — auf LinkedIn, bald auch im Podcast.
          </p>
          <a
            href="/ueber-mich"
            class="inline-flex items-center gap-2 px-6 py-3 bg-brand-navy text-white font-bold rounded-xl hover:bg-brand-navy/90 transition-colors text-sm"
          >
            Die ganze Geschichte lesen →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- LINKEDIN / CONTENT -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 md:px-8 max-w-4xl">

      <div class="text-center mb-12">
        <p class="text-brand-red font-semibold tracking-widest uppercase text-xs mb-3">Aktuell</p>
        <h2 class="text-3xl md:text-4xl font-heading font-black text-brand-navy tracking-tight">
          Was ich gerade mache.
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

        <div class="bg-brand-light rounded-2xl p-6 border border-slate-100">
          <div class="text-3xl mb-4" aria-hidden="true">📖</div>
          <h3 class="font-heading font-bold text-brand-navy mb-2">Neues Buch</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            <strong>"KI, Datenschutz & Compliance"</strong> ist in Arbeit — ein Praxisleitfaden für rechtssicheren KI-Einsatz, klar und ohne Juristendeutsch.
          </p>
        </div>

        <div class="bg-brand-light rounded-2xl p-6 border border-slate-100">
          <div class="text-3xl mb-4" aria-hidden="true">🎙️</div>
          <h3 class="font-heading font-bold text-brand-navy mb-2">Podcast & LinkedIn</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Ich baue mein Podcast-Format auf und teile auf <a href="https://www.linkedin.com/in/david-mirga-847336134/" target="_blank" rel="noopener noreferrer" class="text-brand-red font-semibold hover:underline">LinkedIn</a> wöchentlich Einblicke zu KI — ohne Hype, mit Substanz.
          </p>
        </div>

        <div class="bg-brand-light rounded-2xl p-6 border border-slate-100">
          <div class="text-3xl mb-4" aria-hidden="true">🧪</div>
          <h3 class="font-heading font-bold text-brand-navy mb-2">KI-Tools testen</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Ich teste laufend neue Tools — für Content, Video, Audio, Marketing, Vertrieb und Unternehmensführung. Was wirklich funktioniert, teile ich. Was nicht, auch.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-20 bg-brand-navy text-center text-white">
    <div class="container mx-auto px-6 md:px-8 max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-heading font-black mb-4 tracking-tight">
        Lass uns reden.
      </h2>
      <p class="text-white/60 mb-10 leading-relaxed text-lg">
        Kein Verkaufsgespräch. Kein Pitch. Nur ein ehrlicher Austausch über KI oder was auch immer dich gerade beschäftigt.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="mailto:mail.davidmirga@gmail.com"
          class="px-8 py-4 bg-brand-red text-white font-bold rounded-xl shadow-lg hover:bg-red-700 transition-all"
        >
          Schreib mir
        </a>
        <a
          href="https://www.linkedin.com/in/david-mirga-847336134/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white/10 text-white border border-white/20 font-bold rounded-xl hover:bg-white/20 transition-colors"
        >
          LinkedIn folgen
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
