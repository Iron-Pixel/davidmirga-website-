---
import BaseLayout from '../layouts/BaseLayout.astro';
import KiPresseEmbed from '../components/KiPresseEmbed.astro';

// Bauplan v2 (26.11.2026), Premium-Fassung. Siehe ENTWURF-STARTSEITE.md
const KURS_URL = 'https://www.caie.at/kurs';
const SPRECHSTUNDE_URL = 'https://www.caie.at/de/ki-sprechstunde';
const LINKEDIN = 'https://www.linkedin.com/in/david-mirga-847336134/';
const INSTAGRAM = 'https://www.instagram.com/davidmirga_ki_mit_ruhepuls/';
const AKTUALISIERT = '26. November 2026';

// Gesperrt bis zum Vorstandsbeschluss KI-Sprechstunde (UMBAU-PLAN.md, "Sperre").
// Nach dem Beschluss: ZEIGE_CAIE_SATZ = true. Der Satz steht dann nicht im ausgelieferten Quelltext, solange false.
const ZEIGE_CAIE_SATZ = true;
const CAIE_SATZ = 'Im Rahmen des Vereins Center for AI and Ethics (caie.at) ist es mein Ziel, ehrenamtlich KI den Menschen und Betrieben in Österreich näherzubringen und bei Herausforderungen, vor allem am Anfang, mit Tipps und Ratschlägen zu helfen.';

const faq = [
  {
    q: 'Ist das wirklich alles kostenlos?',
    a: 'Ja. Der Grundkurs, der KI-Kompass und das KI-Lexikon online kosten nichts. Für den KI-Kompass brauchst du nur deine E-Mail-Adresse.',
  },
  {
    q: 'Brauche ich Vorwissen?',
    a: 'Nein. Wenn du eine E-Mail schreiben kannst, kannst du anfangen. Der Grundkurs beginnt ganz am Anfang.',
  },
  {
    q: 'Was hast du davon?',
    a: 'Ich will, dass mehr Menschen KI verstehen und selbst nutzen. Und bei jeder Frage, die mir jemand stellt, lerne ich selbst dazu.',
  },
  {
    q: 'Wer steckt hinter dem Grundkurs und den KI Presse News?',
    a: 'Beides habe ich geschrieben. Bereitgestellt werden sie vom Verein Center for AI and Ethics (CAIE) in Wien, in dem ich ehrenamtlich im Vorstand bin.',
  },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.davidmirga.com/#person",
      "name": "David Mirga",
      "jobTitle": "Diplomierter Strategischer KI-Manager und KI-Buchautor",
      "image": "https://www.davidmirga.com/images/david-mirga-hemd-hoch.jpg",
      "url": "https://www.davidmirga.com",
      "address": { "@type": "PostalAddress", "addressLocality": "Wien", "addressCountry": "AT" },
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "name": "Diplom Strategischer KI-Manager",
        "recognizedBy": { "@type": "Organization", "name": "BFI Wien" }
      },
      "memberOf": { "@type": "Organization", "name": "Center for AI and Ethics (CAIE)", "url": "https://www.caie.at" },
      "knowsAbout": ["Künstliche Intelligenz", "KI-Grundbildung", "KI im Arbeitsalltag", "KI im Betrieb einführen", "Generative KI", "Prompting"],
      "sameAs": [
        LINKEDIN,
        INSTAGRAM,
        "https://www.instagram.com/david_mirga_/",
        "https://x.com/davetherealrave",
        "https://kilexikon.com/"
      ],
      "description": "David Mirga aus Wien erklärt KI so, dass sie im Alltag funktioniert. Autor von drei KI-Büchern, darunter das erste große deutschsprachige KI-Lexikon mit über 5.000 Begriffen, und Autor eines kostenlosen KI-Grundkurses."
    },
    { "@type": "Book", "name": "Das große KI-Lexikon: 5000 Begriffe der Künstlichen Intelligenz", "isbn": "979-8286092918", "datePublished": "2025-06-04", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    { "@type": "Book", "name": "Der ultimative KI-Kompass", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    { "@type": "Book", "name": "KI endlich einfach erklärt", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    { "@type": "Book", "name": "Digitales Recruiting kinderleicht", "isbn": "978-3-7598-2368-7", "inLanguage": "de", "author": { "@id": "https://www.davidmirga.com/#person" } },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    }
  ]
});

const kennst = [
  { t: 'Alle reden von KI, und du fragst dich, ob dein Job bleibt.', link: KURS_URL, l: 'Zum KI-Grundkurs' },
  { t: 'Du sitzt vor ChatGPT und weißt nicht, was du eintippen sollst.', link: KURS_URL, l: 'Erste Lektion im Grundkurs' },
  { t: 'Dein Team nutzt längst KI, und keiner redet darüber. Schatten-KI kann für ein Unternehmen sehr gefährlich sein.', link: '/ki-check', l: 'Zum KI-Check' },
  { t: 'Gefühlt kommt jeden Tag ein neues sensationelles Tool heraus. Was stimmt, und was ist nur Lärm?', link: '/ki-presse-news', l: 'KI-News, gefiltert für Produktivität' },
  { t: 'Du kennst die Tools, aber in deinem Team kommt KI nicht an.', link: 'mailto:mail.davidmirga@gmail.com', l: 'Schreib mir' },
];

const ext = (u: string) => u.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---

<BaseLayout
  pageTitle="Darf’s ein bisschen Hilfe sein? KI leicht verständlich"
  description="David Mirga aus Wien: KI leicht verständlich machen, zeigen, was möglich ist und was wirklich funktioniert, und wie auch alle im Team mitziehen können. Autor von drei KI-Büchern und des ersten großen deutschsprachigen KI-Lexikons mit über 5.000 Begriffen. KI-Grundkurs kostenlos, ohne Anmeldung."
>
  <script type="application/ld+json" slot="head-schema" set:html={schema} />

  <div class="bg-white text-brand-navy">

  <!-- 1 · KOPF -->
    <section class="pt-12 md:pt-16 pb-10 md:pb-12">
      <div class="container mx-auto px-6 md:px-10 max-w-6xl">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

          <div class="lg:col-span-7">
            <figure class="relative pl-14 md:pl-[4.5rem] mb-7">
              <span aria-hidden="true" class="absolute left-0 -top-5 md:-top-7 font-serif text-[6.5rem] md:text-[8rem] leading-none text-brand-red/85 select-none">“</span>
              <blockquote class="text-xl md:text-[1.35rem] leading-snug text-[#6B7A78] max-w-md [text-wrap:balance]">Niemand gibt gern zu, dass er bei KI nicht mehr mitkommt.</blockquote>
            </figure>
            <h1 class="font-sans font-semibold text-[2.5rem] leading-[1.05] md:text-[3.4rem] lg:text-[3.6rem] tracking-[-0.035em] text-[#132B2C] mb-7">
              Darf’s ein bisschen<br/>Hilfe sein?
            </h1>

            {ZEIGE_CAIE_SATZ && (
              <p class="text-xl md:text-[1.35rem] leading-relaxed text-[#1F3B3A] mb-8 [text-wrap:pretty]">{CAIE_SATZ}</p>
            )}

            <div class="flex flex-col sm:flex-row gap-4 mb-3">
              <a data-umami-event="Sprechstunde Kopf" href={SPRECHSTUNDE_URL} target="_blank" rel="noopener" class="whitespace-nowrap inline-flex justify-center items-center gap-3 px-7 py-4 bg-brand-red text-white text-lg font-semibold rounded-xl hover:bg-brand-redDark transition-colors">
                Zur KI-Sprechstunde <span aria-hidden="true">↗</span>
              </a>
              <a data-umami-event="Grundkurs Kopf" href={KURS_URL} target="_blank" rel="noopener" class="whitespace-nowrap inline-flex justify-center items-center gap-3 px-7 py-4 border-2 border-[#132B2C]/25 text-[#132B2C] text-lg font-semibold rounded-xl hover:border-[#132B2C] transition-colors">
                Grundkurs kostenlos starten <span aria-hidden="true">↗</span>
              </a>
            </div>
            <p class="text-base text-[#6B7A78] mb-10">Ehrenamtlich vom Verein CAIE (Center for AI and Ethics): ein kostenloses Telefongespräch von 15&nbsp;Minuten. Es entstehen keine Kosten, auch nicht danach.<br/>Sprechstunde und Grundkurs findest du auf caie.at, der Website des Vereins.</p>

            <p class="text-base font-semibold text-brand-red mb-2">Meine Mission</p>
            <p class="text-lg md:text-xl leading-relaxed text-[#6B7A78]">
              KI leicht verständlich machen.<br/>
              Zeigen, was möglich ist und was wirklich funktioniert.<br/>
              Und wie auch alle im Team einfach mitziehen können.
            </p>
          </div>

          <div class="lg:col-span-5 max-w-md mx-auto lg:max-w-none w-full">
            <div class="flex items-center gap-4 mb-6">
              <button
                type="button"
                id="foto-oeffnen"
                data-umami-event="Foto vergroessert"
                class="shrink-0 rounded-full cursor-zoom-in focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-red/40 transition-transform hover:scale-105"
                aria-label="Foto von David Mirga groß anzeigen"
              >
                <img
                  src="/images/david-mirga-hemd-hoch.jpg"
                  alt="David Mirga, KI-Buchautor aus Wien"
                  width="640" height="800"
                  class="w-24 h-24 rounded-full object-cover object-top ring-2 ring-white shadow-md"
                />
              </button>
              <p class="text-base text-[#6B7A78] leading-snug">
                <span class="font-semibold text-[#132B2C]">David Mirga</span> · 3-facher KI-Autor<br/>
                <span class="xl:whitespace-nowrap">Vorstand im Center for AI and Ethics (Europe), Wien</span>
              </p>
            </div>
            <div class="relative rotate-[1deg] hover:rotate-0 transition-transform duration-300">
              <div class="relative rounded-2xl overflow-hidden ring-1 ring-[#132B2C]/10 shadow-[0_30px_60px_-30px_rgba(19,43,44,0.5)]">
                <KiPresseEmbed variant="titel" title="KI Presse News – Titelseite der aktuellen Ausgabe" />
              </div>
              <a data-umami-event="Zeitung Kopf (Bild)" href="/ki-presse-news" class="absolute inset-0 z-10" aria-label="KI-Wochen-News lesen"></a>
            </div>
            <a data-umami-event="Zeitung Kopf (Link)" href="/ki-presse-news" class="mt-5 inline-flex items-center gap-2 text-lg font-semibold text-brand-red hover:text-brand-redDark">
              Aktuelle Ausgabe lesen <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>

        <div class="mt-12 md:mt-14 bg-[#F2EFE7] rounded-3xl px-6 md:px-14 py-10 md:py-12 md:w-fit md:mx-auto">
          <figure class="relative w-fit mx-auto pl-14 md:pl-20">
            <span aria-hidden="true" class="absolute left-0 -top-3 md:-top-4 font-serif text-[6.5rem] md:text-[8rem] leading-none text-brand-red/85 select-none">“</span>
            <blockquote class="text-2xl md:text-[1.75rem] leading-snug font-medium tracking-[-0.01em] text-[#132B2C] md:max-w-[37rem]">
              Wie komme ich bei KI mit, auch wenn ich kein Computer‑Genie bin, und wie nehme ich meine Mitarbeiter und Kollegen dabei mit?
            </blockquote>
            <figcaption class="mt-4 text-base text-[#6B7A78]">Hier findest du Antworten auf diese Frage.</figcaption>
          </figure>
        </div>
      </div>
    </section>

  <!-- Zahlen -->
  <section class="border-y border-brand-navy/10 bg-white/60">
    <div class="container mx-auto px-6 md:px-10 max-w-6xl">
      <dl class="grid grid-cols-2 md:grid-cols-4 md:divide-x divide-brand-navy/10">
        <div class="py-8 px-4 text-center"><dt class="sr-only">Bücher</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">4</dd><p class="text-base text-[#6B7A78] mt-2">Fachbücher, drei über KI</p></div>
        <div class="py-8 px-4 text-center"><dt class="sr-only">Lexikon</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">5.000+</dd><p class="text-base text-[#6B7A78] mt-2">Begriffe im KI-Lexikon</p></div>
        <div class="py-8 px-4 text-center"><dt class="sr-only">Kurs</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">39</dd><p class="text-base text-[#6B7A78] mt-2">Lektionen im Grundkurs</p></div>
        <div class="py-8 px-4 text-center"><dt class="sr-only">Projekte</dt><dd class="font-sans font-semibold tracking-[-0.03em] text-4xl md:text-5xl text-[#132B2C]">30+</dd><p class="text-base text-[#6B7A78] mt-2">KI-Projekte</p></div>
      </dl>
    </div>
  </section>

  <!-- 2 · KENNST DU DAS? -->
  <section class="bg-[#132B2C] text-[#F7F4EE] py-16 md:py-20">
    <div class="container mx-auto px-6 md:px-10 max-w-6xl">
      <p class="text-base font-semibold text-[#C4643A] mb-4">Kennst du das?</p>
      <h2 class="font-sans font-semibold text-4xl md:text-5xl leading-[1.1] tracking-[-0.03em] mb-10 max-w-3xl">
        Die meisten Fragen zu KI beginnen nicht mit Technik, sondern mit einem Gefühl.
      </h2>
      <ol class="border-t border-white/15">
        {kennst.map((k, i) => (
          <li class="border-b border-white/15">
            <a data-umami-event={`Kennst du das 0${i + 1}`} href={k.link} {...ext(k.link)} class="group grid md:grid-cols-12 gap-3 md:gap-8 py-7 md:py-8 items-baseline">
              <span class="md:col-span-1 font-sans font-semibold text-lg text-[#C4643A]">0{i + 1}</span>
              <span class="md:col-span-7 text-xl md:text-2xl leading-snug text-[#F7F4EE]">{k.t}</span>
              <span class="md:col-span-4 md:text-right text-lg font-semibold text-[#C4643A] group-hover:text-[#F7F4EE] underline-offset-4 group-hover:underline transition-colors">{k.l} <span aria-hidden="true" class="inline-block group-hover:translate-x-1 transition-transform">→</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3 · SELBST LERNEN -->
  <section class="py-16 md:py-20">
    <div class="container mx-auto px-6 md:px-10 max-w-6xl">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="text-base font-semibold text-brand-red mb-4">Bücher, Kurs und Lexikon</p>
        <h2 class="font-sans font-semibold text-4xl md:text-5xl leading-[1.1] tracking-[-0.03em] text-[#132B2C]">Selbst lernen, im eigenen Tempo.</h2>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 pb-12 mb-12 border-b border-brand-navy/10">
        <div class="lg:col-span-5">
          <p class="text-base font-semibold text-[#6B7A78] mb-2">KI-Grundkurs</p>
          <h3 class="font-sans font-semibold text-3xl md:text-4xl leading-tight tracking-[-0.025em] text-[#132B2C] mb-6">KI sicher im Alltag nutzen</h3>
          <a data-umami-event="Grundkurs Abschnitt" href={KURS_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-3 px-8 py-4 bg-brand-red text-white text-lg font-semibold rounded-xl hover:bg-brand-redDark transition-colors">
            Grundkurs starten <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="lg:col-span-7 text-xl leading-relaxed text-[#1F3B3A] space-y-5">
          <p>39 kurze Lektionen, jede mit einem kleinen Wissens-Check. Du lernst an Aufgaben aus dem echten Leben.</p>
          <p class="text-base text-[#6B7A78]">Geschrieben von mir, bereitgestellt vom Verein Center for AI and Ethics (CAIE).</p>
        </div>
        <div class="lg:col-span-12">
          <p class="text-base font-semibold text-brand-red mb-5">Ein kleiner Einblick in den Kurs</p>
          <ul class="grid md:grid-cols-3 gap-5">
            <li class="bg-[#F2EFE7] rounded-2xl p-7 border-t-4 border-brand-red/70 text-xl md:text-2xl leading-snug font-medium text-[#132B2C]">„Mensch – KI – Mensch. Ich überlege. Die KI hilft. Ich entscheide.“</li>
            <li class="bg-[#F2EFE7] rounded-2xl p-7 border-t-4 border-brand-red/70 text-xl md:text-2xl leading-snug font-medium text-[#132B2C]">„Nur eingeben, was auch auf einer Postkarte stehen dürfte.“</li>
            <li class="bg-[#F2EFE7] rounded-2xl p-7 border-t-4 border-brand-red/70 text-xl md:text-2xl leading-snug font-medium text-[#132B2C]">„Geht es um Geld: auflegen und selbst zurückrufen.“</li>
          </ul>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 md:gap-16">
        <a data-umami-event="KI-Kompass" href="/downloads/ki-kompass" class="group flex gap-8 items-start">
          <img src="/ki-kompass.jpg" alt="Buchcover Der ultimative KI-Kompass" class="w-32 md:w-36 rounded shadow-[0_20px_40px_-15px_rgba(19,43,44,0.5)] group-hover:-translate-y-1 transition-transform flex-shrink-0" />
          <div>
            <h3 class="font-sans font-semibold text-2xl md:text-[1.75rem] leading-tight tracking-[-0.02em] text-[#132B2C] mb-3">Der ultimative KI-Kompass</h3>
            <p class="text-lg text-[#1F3B3A] mb-4">598 Seiten, verständlich für alle. Als Geschenk zum Herunterladen.</p>
            <span class="text-brand-red font-semibold text-lg">Lesen →</span>
          </div>
        </a>
        <a data-umami-event="KI-Lexikon" href="https://kilexikon.com/" target="_blank" rel="noopener" class="group flex gap-8 items-start">
          <img src="/images/cover-lexikon.jpg" alt="Buchcover Das große KI-Lexikon" class="w-32 md:w-36 rounded shadow-[0_20px_40px_-15px_rgba(19,43,44,0.5)] group-hover:-translate-y-1 transition-transform flex-shrink-0" />
          <div>
            <h3 class="font-sans font-semibold text-2xl md:text-[1.75rem] leading-tight tracking-[-0.02em] text-[#132B2C] mb-3">Das große KI-Lexikon</h3>
            <p class="text-lg text-[#1F3B3A] mb-4">Das erste große deutschsprachige KI-Lexikon. Über 5.000 Begriffe, klar erklärt.</p>
            <span class="text-brand-red font-semibold text-lg">Begriff nachschlagen →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4 · ZUM VERTIEFEN -->
  <section class="py-16 md:py-20 bg-white/70 border-t border-brand-navy/10">
    <div class="container mx-auto px-6 md:px-10 max-w-6xl">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="text-base font-semibold text-brand-red mb-4">Zum Vertiefen</p>
        <h2 class="font-sans font-semibold text-4xl md:text-5xl leading-[1.1] tracking-[-0.03em] text-[#132B2C]">Für alle, die schon mit KI arbeiten.</h2>
      </div>

      <div>
        <div class="max-w-3xl divide-y divide-brand-navy/10 border-y border-brand-navy/10">
          <div class="py-8">
            <h3 class="font-sans font-semibold text-2xl md:text-[1.75rem] tracking-[-0.02em] text-[#132B2C] mb-3">KI Presse News</h3>
            <p class="text-lg text-[#1F3B3A] leading-relaxed mb-4">Jede Woche die wichtigsten KI-Nachrichten, kurz und mit Originalquellen. Herausgegeben vom Verein Center for AI and Ethics, in dem ich im Vorstand bin.</p>
            <a data-umami-event="Zeitung Vertiefen" href="/ki-presse-news" class="text-brand-red font-semibold text-lg">Aktuelle Ausgabe lesen →</a>
          </div>
          <div class="py-8">
            <h3 class="font-sans font-semibold text-2xl md:text-[1.75rem] tracking-[-0.02em] text-[#132B2C] mb-3">KI mit Ruhepuls</h3>
            <p class="text-lg text-[#1F3B3A] leading-relaxed mb-4">Jeden Werktag ein kurzer KI-Impuls. Ohne Hype, ohne Fachchinesisch.</p>
            <a data-umami-event="LinkedIn Vertiefen" href={LINKEDIN} target="_blank" rel="noopener" class="text-brand-red font-semibold text-lg">LinkedIn →</a>
            <span class="text-[#6B7A78]/50 mx-3">·</span>
            <a data-umami-event="Instagram Vertiefen" href={INSTAGRAM} target="_blank" rel="noopener" class="text-brand-red font-semibold text-lg">Instagram →</a>
          </div>
          <div class="py-8">
            <h3 class="font-sans font-semibold text-2xl md:text-[1.75rem] tracking-[-0.02em] text-[#132B2C] mb-3">Blog</h3>
            <p class="text-lg text-[#1F3B3A] leading-relaxed mb-4">Längere Texte zu KI im Alltag und im Betrieb.</p>
            <a data-umami-event="Blog Vertiefen" href="/blog" class="text-brand-red font-semibold text-lg">Zum Blog →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · HÄUFIGE FRAGEN -->
  <section class="py-16 md:py-20 border-t border-brand-navy/10">
    <div class="container mx-auto px-6 md:px-10 max-w-4xl">
      <h2 class="font-sans font-semibold text-4xl md:text-5xl leading-[1.1] tracking-[-0.03em] text-[#132B2C] mb-12">Häufige Fragen</h2>
      <div class="border-t border-brand-navy/15">
        {faq.map((f) => (
          <details class="group border-b border-brand-navy/15">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-6 py-7">
              <h3 class="text-xl md:text-2xl font-medium text-[#132B2C]">{f.q}</h3>
              <span class="w-10 h-10 flex-shrink-0 rounded-full border border-brand-navy/25 flex items-center justify-center text-brand-red text-2xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-lg md:text-xl text-[#1F3B3A] leading-relaxed pb-8 max-w-3xl">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 · KONTAKT -->
  <section id="kontakt" class="bg-[#132B2C] text-[#F7F4EE] py-16 md:py-20">
    <div class="container mx-auto px-6 md:px-10 max-w-4xl text-center">
      <h2 class="font-sans font-semibold text-5xl md:text-6xl leading-[1.05] tracking-[-0.035em] mb-6">Steckst du fest?</h2>
      <p class="text-xl md:text-2xl text-[#F7F4EE]/80 mb-12">Schreib mir auf Social Media. Ich antworte persönlich.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a data-umami-event="LinkedIn Schluss" href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 px-9 py-4 bg-[#F7F4EE] text-[#132B2C] text-lg font-semibold rounded-xl hover:bg-[#C4643A] transition-colors">Auf LinkedIn <span aria-hidden="true">↗</span></a>
        <a data-umami-event="Instagram Schluss" href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 px-9 py-4 border border-[#F7F4EE]/30 text-[#F7F4EE] text-lg font-semibold rounded-xl hover:border-[#C4643A] hover:text-[#C4643A] transition-colors">Auf Instagram <span aria-hidden="true">↗</span></a>
      </div>
      <p class="mt-10 text-[#F7F4EE]/65 text-lg">
        Lieber erst selbst probieren? <a data-umami-event="Grundkurs Schluss" href={KURS_URL} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-[#C4643A] hover:text-[#C4643A]">Grundkurs kostenlos starten ↗</a>
      </p>
      <p class="mt-6 text-[#F7F4EE]/60 text-base">Zuletzt aktualisiert: {AKTUALISIERT}</p>
    </div>
  </section>

  </div>
  <!-- Foto groß (Klick auf das runde Foto im Kopf) -->
  <dialog id="foto-gross" class="foto-dialog p-0 bg-transparent max-w-[90vw] max-h-[92vh] overflow-hidden" aria-label="Foto von David Mirga">
    <img
      src="/images/david-mirga-hemd-hoch.jpg"
      alt="David Mirga, KI-Buchautor aus Wien"
      width="640" height="800"
      class="block max-h-[78vh] w-auto rounded-2xl shadow-2xl"
    />
    <p class="mt-3 text-center text-lg text-white">Klick daneben oder Esc schließt das Foto.</p>
  </dialog>
  <script>
    const knopf = document.getElementById('foto-oeffnen');
    const dlg = document.getElementById('foto-gross') as HTMLDialogElement | null;
    knopf?.addEventListener('click', () => dlg?.showModal());
    dlg?.addEventListener('click', () => dlg.close());
  </script>
  <style>
    .foto-dialog::backdrop { background: rgba(36, 85, 86, 0.85); }
  </style>
</BaseLayout>
