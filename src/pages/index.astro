---
import BaseLayout from '../layouts/BaseLayout.astro';
import KiPresseEmbed from '../components/KiPresseEmbed.astro';

// Bauplan v2 (26.11.2026), siehe ENTWURF-STARTSEITE.md
const KURS_URL = 'https://www.caie.at/kurs';
const LINKEDIN = 'https://www.linkedin.com/in/david-mirga-847336134/';
const INSTAGRAM = 'https://www.instagram.com/davidmirga_ki_mit_ruhepuls/';
const AKTUALISIERT = '26. November 2026';

const faq = [
  {
    q: 'Ist das wirklich alles gratis?',
    a: 'Ja. Der Grundkurs, der KI-Kompass und das KI-Lexikon online kosten nichts. Du musst dich nirgends anmelden.',
  },
  {
    q: 'Brauche ich Vorwissen?',
    a: 'Nein. Wenn du eine E-Mail schreiben kannst, kannst du anfangen. Der Grundkurs beginnt ganz am Anfang.',
  },
  {
    q: 'Was hast du davon?',
    a: 'Ich will, dass mehr Menschen KI verstehen und selbst nutzen. Und bei jeder Frage, die mir jemand stellt, lerne ich selbst dazu.',
  },
  {
    q: 'Wer steckt hinter dem Grundkurs und den KI Presse News?',
    a: 'Beides habe ich geschrieben. Bereitgestellt werden sie vom Verein Center for AI and Ethics (CAIE) in Wien, in dem ich ehrenamtlich im Vorstand bin.',
  },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.davidmirga.com/#person",
      "name": "David Mirga",
      "jobTitle": "Diplomierter Strategischer KI-Manager und KI-Buchautor",
      "image": "https://www.davidmirga.com/images/david-mirga-profil.png",
      "url": "https://www.davidmirga.com",
      "address": { "@type": "PostalAddress", "addressLocality": "Wien", "addressCountry": "AT" },
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "name": "Diplom Strategischer KI-Manager",
        "recognizedBy": { "@type": "Organization", "name": "BFI Wien" }
      },
      "memberOf": { "@type": "Organization", "name": "Center for AI and Ethics (CAIE)", "url": "https://www.caie.at" },
      "knowsAbout": ["Künstliche Intelligenz", "KI-Grundbildung", "KI im Arbeitsalltag", "KI im Betrieb einführen", "Generative KI", "Prompting"],
      "sameAs": [
        LINKEDIN,
        INSTAGRAM,
        "https://www.instagram.com/david_mirga_/",
        "https://x.com/davetherealrave",
        "https://kilexikon.com/"
      ],
      "description": "David Mirga aus Wien erklärt KI so, dass sie im Alltag funktioniert. Autor von drei KI-Büchern, darunter das erste große deutschsprachige KI-Lexikon mit über 5.000 Begriffen, und Autor eines kostenlosen KI-Grundkurses."
    },
    {
      "@type": "Book",
      "name": "Das große KI-Lexikon: 5000 Begriffe der Künstlichen Intelligenz",
      "isbn": "979-8286092918",
      "datePublished": "2025-06-04",
      "inLanguage": "de",
      "author": { "@id": "https://www.davidmirga.com/#person" }
    },
    {
      "@type": "Book",
      "name": "Der ultimative KI-Kompass",
      "inLanguage": "de",
      "author": { "@id": "https://www.davidmirga.com/#person" }
    },
    {
      "@type": "Book",
      "name": "KI endlich einfach erklärt",
      "inLanguage": "de",
      "author": { "@id": "https://www.davidmirga.com/#person" }
    },
    {
      "@type": "Book",
      "name": "Digitales Recruiting kinderleicht",
      "isbn": "978-3-7598-2368-7",
      "inLanguage": "de",
      "author": { "@id": "https://www.davidmirga.com/#person" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
});

const kennst = [
  { t: 'Alle reden von KI, und du fragst dich, ob dein Job bleibt?', link: KURS_URL, l: 'Im Grundkurs anfangen' },
  { t: 'Du sitzt vor ChatGPT und weißt nicht, was du eintippen sollst?', link: KURS_URL, l: 'Die erste Übung machen' },
  { t: 'Dein Team nutzt längst KI, und keiner redet darüber?', link: '/ki-check', l: 'Wo steht dein Betrieb?' },
  { t: 'Jeden Tag ein neues Wunder-Tool, und du weißt nicht, was davon stimmt?', link: '/ki-presse-news', l: 'Die Woche in Ruhe lesen' },
  { t: 'Du kennst die Tools, aber in deinem Team kommt KI nicht an?', link: '/ueber-mich', l: 'Wie ich darüber denke' },
];
---

<BaseLayout
  pageTitle="Was KI kann. Was nicht. Und was das für dich heißt."
  description="David Mirga aus Wien: Was KI kann, was nicht, und was das für dich heißt. Autor von drei KI-Büchern und des ersten großen deutschsprachigen KI-Lexikons mit über 5.000 Begriffen. KI-Grundkurs gratis, ohne Anmeldung."
>
  <script type="application/ld+json" slot="head-schema" set:html={schema} />

  <!-- 1 · KOPF -->
  <section class="pt-12 pb-14 bg-brand-navy relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-[120px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>

    <div class="container mx-auto px-6 md:px-8 max-w-6xl relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-14">

        <div class="flex-1 text-center lg:text-left">
          <p class="text-[#E9C7B1] font-semibold tracking-widest uppercase text-sm mb-5">David Mirga · Wien</p>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-black text-white leading-tight tracking-tight mb-6">
            Was KI kann. Was nicht.<br/>
            <span class="text-brand-red">Und was das für dich heißt.</span>
          </h1>

          <p class="text-xl text-white/85 leading-relaxed max-w-2xl mb-5 mx-auto lg:mx-0">
            Ob du KI zum ersten Mal öffnest oder schon jeden Tag damit arbeitest: Entscheidend ist, dass sie im Alltag wirklich funktioniert. Für dich, dein Team und deinen Betrieb.
          </p>

          <p class="text-base text-white/70 leading-relaxed max-w-2xl mb-9 mx-auto lg:mx-0">
            Autor von drei KI-Büchern · Das erste große deutschsprachige KI-Lexikon mit über 5.000 Begriffen · Diplomierter KI-Manager
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
            <a href={KURS_URL} target="_blank" rel="noopener" class="w-full sm:w-auto px-8 py-4 bg-brand-red text-white text-lg font-bold rounded-lg shadow-lg hover:bg-red-700 transition-all text-center">
              Grundkurs starten, gratis
            </a>
            <a href="/downloads/ki-kompass" class="w-full sm:w-auto px-7 py-4 bg-white/10 text-white border border-white/25 font-bold rounded-lg hover:bg-white/20 transition-colors text-center">
              KI-Kompass gratis lesen
            </a>
            <a href="#kontakt" class="text-white/80 font-semibold underline underline-offset-4 hover:text-white px-2 py-2">
              Schreib mir
            </a>
          </div>
        </div>

        <div class="flex-shrink-0">
          <img
            src="/images/david-mirga-profil.png"
            alt="David Mirga, KI-Buchautor aus Wien"
            width="360" height="360"
            class="w-44 h-44 md:w-72 md:h-72 lg:w-[360px] lg:h-[360px] rounded-3xl object-cover object-top shadow-2xl ring-4 ring-white/10"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- Leiste: Zahlen -->
  <section class="py-7 bg-brand-navy border-t border-white/10">
    <div class="container mx-auto px-6 md:px-8 max-w-5xl">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-white font-black text-3xl leading-none">4</p><p class="text-white/70 text-sm mt-2">Fachbücher, 3 davon über KI</p></div>
        <div><p class="text-white font-black text-3xl leading-none">5.000+</p><p class="text-white/70 text-sm mt-2">Begriffe im KI-Lexikon</p></div>
        <div><p class="text-white font-black text-3xl leading-none">39</p><p class="text-white/70 text-sm mt-2">Lektionen im Grundkurs</p></div>
        <div><p class="text-white font-black text-3xl leading-none">20+</p><p class="text-white/70 text-sm mt-2">KI-Weiterbildungen gemacht</p></div>
      </div>
    </div>
  </section>

  <!-- 2 · KENNST DU DAS? -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 md:px-8 max-w-5xl">
      <h2 class="text-3xl md:text-4xl font-heading font-black text-brand-navy tracking-tight text-center mb-12">Kennst du das?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {kennst.map((k) => (
          <a href={k.link} target={k.link.startsWith('http') ? '_blank' : undefined} rel={k.link.startsWith('http') ? 'noopener' : undefined}
             class="group block bg-brand-light rounded-2xl p-7 border border-slate-100 hover:border-brand-red/40 hover:shadow-md transition-all">
            <p class="text-lg text-brand-navy font-semibold leading-snug mb-4">{k.t}</p>
            <span class="text-brand-red font-bold text-base">{k.l} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · SELBST LERNEN -->
  <section class="py-20 bg-brand-light">
    <div class="container mx-auto px-6 md:px-8 max-w-5xl">
      <p class="text-brand-red font-semibold tracking-widest uppercase text-sm mb-3 text-center">Gratis</p>
      <h2 class="text-3xl md:text-4xl font-heading font-black text-brand-navy tracking-tight text-center mb-4">Selbst lernen, im eigenen Tempo.</h2>
      <p class="text-lg text-slate-700 text-center max-w-2xl mx-auto mb-12">Ohne Anmeldung, ohne Kosten. Fang dort an, wo du gerade stehst.</p>

      <div class="bg-brand-navy rounded-2xl p-8 md:p-12 mb-6 shadow-xl">
        <p class="text-[#E9C7B1] font-semibold uppercase tracking-widest text-sm mb-3">KI-Grundkurs</p>
        <h3 class="text-2xl md:text-3xl font-heading font-black text-white mb-4">KI sicher im Alltag nutzen</h3>
        <p class="text-lg text-white/85 leading-relaxed max-w-2xl mb-3">
          39 kurze Lektionen mit kleinen Wissens-Checks. Zum Beispiel: Du gibst der KI einen schwierigen Brief und lässt dir erklären, was von dir verlangt wird. Dann prüfst du selbst, ob Betrag und Frist stimmen.
        </p>
        <p class="text-base text-white/65 mb-8">Geschrieben von mir, bereitgestellt vom Verein Center for AI and Ethics (CAIE).</p>
        <a href={KURS_URL} target="_blank" rel="noopener" class="inline-block px-8 py-4 bg-brand-red text-white text-lg font-bold rounded-lg shadow-lg hover:bg-red-700 transition-all">
          Grundkurs starten, gratis
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/downloads/ki-kompass" class="group flex gap-6 items-center bg-white rounded-2xl p-6 border border-slate-100 hover:border-brand-red/40 hover:shadow-md transition-all">
          <img src="/ki-kompass.jpg" alt="Buchcover Der ultimative KI-Kompass" class="w-24 rounded-lg shadow-md flex-shrink-0" />
          <div>
            <h3 class="font-heading font-bold text-brand-navy text-xl mb-2">Der ultimative KI-Kompass</h3>
            <p class="text-base text-slate-600 mb-3">598 Seiten, verständlich für alle. Als Geschenk zum Herunterladen.</p>
            <span class="text-brand-red font-bold">Gratis lesen →</span>
          </div>
        </a>
        <a href="https://kilexikon.com/" target="_blank" rel="noopener" class="group flex gap-6 items-center bg-white rounded-2xl p-6 border border-slate-100 hover:border-brand-red/40 hover:shadow-md transition-all">
          <img src="/images/cover-lexikon.jpg" alt="Buchcover Das große KI-Lexikon" class="w-24 rounded-lg shadow-md flex-shrink-0" />
          <div>
            <h3 class="font-heading font-bold text-brand-navy text-xl mb-2">Das große KI-Lexikon</h3>
            <p class="text-base text-slate-600 mb-3">Das erste große deutschsprachige KI-Lexikon. Über 5.000 Begriffe, klar erklärt.</p>
            <span class="text-brand-red font-bold">Begriff nachschlagen →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4 · ZUM VERTIEFEN -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 md:px-8 max-w-6xl">
      <h2 class="text-3xl md:text-4xl font-heading font-black text-brand-navy tracking-tight text-center mb-4">Zum Vertiefen.</h2>
      <p class="text-lg text-slate-700 text-center max-w-2xl mx-auto mb-12">Für alle, die schon mit KI arbeiten und auf dem Laufenden bleiben wollen.</p>

      <div class="flex flex-col lg:flex-row gap-10 items-start">
        <div class="w-full max-w-md mx-auto lg:mx-0 lg:w-[400px] flex-shrink-0">
          <p class="text-base font-semibold text-brand-navy mb-3">KI Presse News · Verein CAIE</p>
          <div class="relative shadow-xl ring-1 ring-black/10 rounded-sm overflow-hidden">
            <KiPresseEmbed variant="titel" title="KI Presse News – Titelseite der aktuellen Ausgabe" />
            <a href="/ki-presse-news" class="absolute inset-0 z-10" aria-label="KI Presse News lesen"></a>
          </div>
        </div>

        <div class="flex-1 space-y-6">
          <div class="bg-brand-light rounded-2xl p-7 border border-slate-100">
            <h3 class="font-heading font-bold text-brand-navy text-xl mb-2">KI Presse News</h3>
            <p class="text-base text-slate-700 leading-relaxed mb-3">Jede Woche die wichtigsten KI-Nachrichten, kurz und mit Originalquellen. Im Verein Center for AI and Ethics bin ich im Vorstand und arbeite an den KI Presse News mit.</p>
            <a href="/ki-presse-news" class="text-brand-red font-bold">Aktuelle Ausgabe lesen →</a>
            <span class="text-slate-400 mx-2">·</span>
            <a href="https://www.caie.at" target="_blank" rel="noopener" class="text-brand-red font-bold">Mehr über den Verein →</a>
          </div>
          <div class="bg-brand-light rounded-2xl p-7 border border-slate-100">
            <h3 class="font-heading font-bold text-brand-navy text-xl mb-2">KI mit Ruhepuls</h3>
            <p class="text-base text-slate-700 leading-relaxed mb-3">Jeden Werktag ein kurzer KI-Impuls auf LinkedIn und Instagram. Ohne Hype, ohne Fachchinesisch.</p>
            <a href={LINKEDIN} target="_blank" rel="noopener" class="text-brand-red font-bold">LinkedIn →</a>
            <span class="text-slate-400 mx-2">·</span>
            <a href={INSTAGRAM} target="_blank" rel="noopener" class="text-brand-red font-bold">Instagram →</a>
          </div>
          <div class="bg-brand-light rounded-2xl p-7 border border-slate-100">
            <h3 class="font-heading font-bold text-brand-navy text-xl mb-2">Blog</h3>
            <p class="text-base text-slate-700 leading-relaxed mb-3">Längere Texte zu KI im Alltag und im Betrieb.</p>
            <a href="/blog" class="text-brand-red font-bold">Zum Blog →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · ÜBER MICH, KURZ -->
  <section class="py-20 bg-brand-light">
    <div class="container mx-auto px-6 md:px-8 max-w-4xl">
      <div class="bg-white rounded-2xl p-8 md:p-12 flex flex-col md:flex-row gap-10 items-center border border-slate-100">
        <img src="/images/David-Mirga.jpg" alt="David Mirga" width="200" height="200" class="rounded-2xl shadow-lg object-cover object-top w-40 h-40 md:w-48 md:h-48 flex-shrink-0" />
        <div class="flex-1 space-y-4">
          <h2 class="text-2xl md:text-3xl font-heading font-black text-brand-navy tracking-tight">Über mich</h2>
          <p class="text-lg text-slate-700 leading-relaxed">
            Ich komme nicht aus der Informatik. Ich habe Maurer gelernt, Unternehmen aufgebaut und bin über Umwege zur KI gekommen, weil ich verstanden habe, dass Technologie nur dann etwas wert ist, wenn sie echte Probleme löst.
          </p>
          <p class="text-lg text-slate-700 leading-relaxed">
            <strong>Was ich gerade lerne:</strong> Seit Ende November ISO 42001 und den EU AI Act. Man lernt bei KI nie aus. In drei bis fünf Monaten ändert sich extrem viel.
          </p>
          <a href="/ueber-mich" class="inline-block px-6 py-3 bg-brand-navy text-white font-bold rounded-xl hover:bg-brand-navy/90 transition-colors">
            Die ganze Geschichte →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · HÄUFIGE FRAGEN -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 md:px-8 max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-heading font-black text-brand-navy tracking-tight text-center mb-10">Häufige Fragen</h2>
      <div class="space-y-4">
        {faq.map((f) => (
          <details class="group bg-brand-light rounded-2xl p-6 border border-slate-100">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-4">
              <h3 class="text-lg font-bold text-brand-navy">{f.q}</h3>
              <span class="text-brand-red text-2xl font-bold group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-lg text-slate-700 leading-relaxed mt-4">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 · KONTAKT -->
  <section id="kontakt" class="py-20 bg-brand-navy text-center text-white">
    <div class="container mx-auto px-6 md:px-8 max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-heading font-black mb-4 tracking-tight">Steckst du fest?</h2>
      <p class="text-white/80 mb-10 leading-relaxed text-xl">Schreib mir. Ich antworte persönlich.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:mail.davidmirga@gmail.com" class="px-8 py-4 bg-brand-red text-white text-lg font-bold rounded-xl shadow-lg hover:bg-red-700 transition-all">Schreib mir</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-white/10 text-white border border-white/20 text-lg font-bold rounded-xl hover:bg-white/20 transition-colors">Auf LinkedIn</a>
      </div>
      <p class="mt-12 text-white/60 text-base">
        Lieber erst selbst probieren? <a href={KURS_URL} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-white">Grundkurs starten, gratis</a>
      </p>
      <p class="mt-6 text-white/50 text-sm">Zuletzt aktualisiert: {AKTUALISIERT}</p>
    </div>
  </section>

</BaseLayout>
