---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  pageTitle: string;
  description?: string;
  noIndex?: boolean;
  type?: 'website' | 'article' | 'profile';
}

const {
  pageTitle,
  description = "David Mirga – Diplomierter KI-Manager aus Wien. Autor des ersten deutschsprachigen KI-Lexikons und 4 Fachbüchern. KI verständlich erklärt, ohne Bullshit.",
  noIndex = false,
  type = 'website'
} = Astro.props;

// WICHTIG: Stellt sicher, dass die URL korrekt ist, selbst wenn Astro.site nicht gesetzt ist
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.href;
---

<!doctype html>
<html lang="de-AT" class="scroll-smooth h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="shortcut icon" href="/favicon.ico">

  <meta name="theme-color" content="#0B1F3F" />
  
  <title>{pageTitle} | David Mirga</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="generator" content={Astro.generator} />
  
  {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
  
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${pageTitle} | David Mirga`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://www.davidmirga.com/images/David-Mirga.jpg" />
  <meta property="og:locale" content="de_AT" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${pageTitle} | David Mirga`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.davidmirga.com/images/David-Mirga.jpg" />
  
  <meta name="geo.region" content="AT-9" />
  <meta name="geo.placename" content="Wien" />
  <meta name="geo.position" content="48.2082;16.3738" />
  <meta name="ICBM" content="48.2082, 16.3738" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <link 
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&display=swap" 
    rel="stylesheet"
    media="print" 
    onload="this.media='all'"
  >
  
  <slot name="head-schema" />

  <!-- Besucherzähler ohne Cookies (Umami Cloud, Server in der EU). Zählt nur auf der echten Domain, nicht lokal. -->
  <script
    is:inline
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id="4e544152-e86c-4500-9057-446348f68ec3"
    data-domains="www.davidmirga.com,davidmirga.com"
    data-do-not-track="true"
  ></script>

  <!-- Ladezeit bei echten Besuchern (Vercel Speed Insights, ohne Cookies). Wirkt erst, wenn es im Vercel-Projekt eingeschaltet ist. -->
  <script is:inline>window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };</script>
  <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
</head>
<body class="bg-brand-light text-slate-700 antialiased flex flex-col min-h-full font-sans">
  
  <header class="fixed w-full z-50 top-0 bg-white/90 backdrop-blur-md border-b border-[#132B2C]/10 transition-all">
    <div class="container mx-auto max-w-6xl h-20 flex items-center justify-between px-6 md:px-10">

      <div class="flex items-center gap-3 md:gap-5">
        <a href="/" class="font-serif text-2xl md:text-[1.7rem] text-brand-navy tracking-tight">
          David Mirga
        </a>
        <a href="/abonnieren" class="hidden sm:inline-flex items-center px-3.5 py-1.5 border border-brand-navy/25 text-brand-navy text-base font-medium rounded-lg hover:border-brand-red hover:text-brand-red transition-colors whitespace-nowrap">
          Abonnieren
        </a>
      </div>

      <nav class="hidden md:flex gap-7 font-medium text-brand-navy/80 items-center text-[15px]">
        <a href="/ueber-mich" class="hover:text-brand-red transition-colors">Über mich</a>

        <a href="/ki-check" class="hover:text-brand-red transition-colors">
          KI-Check
        </a>

        <a data-umami-event="Sprechstunde Menue" href="https://www.caie.at/de/ki-sprechstunde" target="_blank" rel="noopener" class="hover:text-brand-red transition-colors">
          KI-Sprechstunde <span aria-hidden="true">↗</span>
        </a>

        <a href="/ki-presse-news" class="hover:text-brand-red transition-colors">KI-Wochen-News</a>

        <a href="/blog" class="hover:text-brand-red transition-colors">Blog</a>
      </nav>
      
      <button id="mobile-menu-btn" class="md:hidden text-brand-navy p-2" aria-label="Menü öffnen">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    
    <nav id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-100 py-4 absolute w-full shadow-lg">
      <div class="px-6 flex flex-col gap-4">
        <a href="/ueber-mich" class="py-2 text-brand-navy hover:text-brand-red transition-colors font-medium">Über mich</a>

        <a href="/ki-check" class="py-2 text-brand-red hover:text-red-700 font-bold transition-colors flex items-center gap-2">
           <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
           KI-Check starten
        </a>

        <a data-umami-event="Sprechstunde Handy-Menue" href="https://www.caie.at/de/ki-sprechstunde" target="_blank" rel="noopener" class="py-2 text-brand-navy hover:text-brand-red transition-colors font-medium">
          KI-Sprechstunde <span aria-hidden="true">↗</span> <span class="text-brand-navy/60 font-normal">(ehrenamtlich)</span>
        </a>

        <a href="/ki-presse-news" class="py-2 text-brand-navy hover:text-brand-red transition-colors font-medium">KI-Wochen-News</a>

        <a href="/blog" class="py-2 text-brand-navy hover:text-brand-red transition-colors font-medium">Blog</a>
      </div>
    </nav>
  </header>
  
  <main class="flex-grow pt-20">
    <slot />
  </main>
  
  <footer class="bg-white border-t border-[#132B2C]/10 pt-14 pb-10 mt-0">
    <div class="container mx-auto max-w-6xl px-6 md:px-10">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="font-serif text-2xl text-[#132B2C] mb-2">David Mirga</p>
          <p class="text-base text-[#6B7A78] mb-5">Wien, Österreich</p>
          <div class="flex gap-5">
            <a href="https://www.linkedin.com/in/david-mirga-847336134/" target="_blank" rel="noopener noreferrer" class="text-[#6B7A78] hover:text-brand-red transition-colors" aria-label="LinkedIn Profil"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg></a>
            <a href="https://www.instagram.com/david_mirga_/" target="_blank" rel="noopener noreferrer" class="text-[#6B7A78] hover:text-brand-red transition-colors" aria-label="Instagram Profil"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg></a>
            <a href="https://x.com/davetherealrave" target="_blank" rel="noopener noreferrer" class="text-[#6B7A78] hover:text-brand-red transition-colors" aria-label="X (Twitter) Profil"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg></a>
          </div>
        </div>
        <div class="md:col-span-2 flex flex-col gap-3 text-base">
          <p class="font-semibold text-[#132B2C]">Über mich</p>
          <a href="/ueber-mich" class="text-[#1F3B3A] hover:text-brand-red transition-colors">Werdegang</a>
          <a href="/presse" class="text-[#1F3B3A] hover:text-brand-red transition-colors">Presse</a>
          <a href="mailto:mail.davidmirga@gmail.com" class="text-[#1F3B3A] hover:text-brand-red transition-colors">Kontakt</a>
        </div>
        <div class="md:col-span-3 flex flex-col gap-3 text-base">
          <p class="font-semibold text-[#132B2C]">Inhalte</p>
          <a href="/ki-presse-news" class="text-[#1F3B3A] hover:text-brand-red transition-colors">KI Presse News</a>
          <a href="/blog" class="text-[#1F3B3A] hover:text-brand-red transition-colors">Blog</a>
          <a href="/ki-check" class="text-[#1F3B3A] hover:text-brand-red transition-colors">KI-Check</a>
          <a href="/downloads/ki-kompass" class="text-[#1F3B3A] hover:text-brand-red transition-colors">Downloads</a>
        </div>
        <div class="md:col-span-2 flex flex-col gap-3 text-base">
          <p class="font-semibold text-[#132B2C]">Rechtliches</p>
          <a href="/impressum" class="text-[#1F3B3A] hover:text-brand-red transition-colors">Impressum</a>
          <a href="/datenschutz" class="text-[#1F3B3A] hover:text-brand-red transition-colors">Datenschutz</a>
        </div>
      </div>
      <div class="mt-12 pt-6 border-t border-[#132B2C]/10 flex flex-col gap-2 text-base text-[#6B7A78]">
        <span>&copy; {new Date().getFullYear()} David Mirga · Wien</span>
        <span>Erstellt Dezember 2024 mit Vibecoding · Ende Februar 2026 von <a href="https://claude.ai/claude-code" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-brand-red transition-colors">Claude Code (KI-Agent)</a> vollständig eigenständig überarbeitet — der Agent hat den gesamten Code selbst geschrieben, ohne dass ein Mensch eine einzige Zeile angefasst hat.</span>
      </div>
    </div>
  </footer>
  
  <CookieBanner />
  
  <script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  </script>
  
</body>
</html>